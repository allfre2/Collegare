APP_ENVIRONMENT=local
RUN_MODE=debug

GIN_PORT=:80

# Session
WEBSOCKETS_WRITE_BUFFER_SIZE=1024
WEBSOCKETS_READ_BUFFER_SIZE=1024

# WebRTC
